{
  "name": "@hc1/design-system",
  "version": "0.9.1",
  "description": "Shared UI package for HC1 IQ products (ClinicalIQ, SourceIQ, HerCare, and future modules). Tokens, components, and playground consumed via a single import path.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./styles": "./src/tokens/css/variables.css",
    "./playground": {
      "types": "./src/playground.ts",
      "default": "./src/playground.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    },
    "class-variance-authority": {
      "optional": false
    },
    "clsx": {
      "optional": false
    },
    "tailwind-merge": {
      "optional": false
    },
    "@radix-ui/react-slot": {
      "optional": false
    },
    "@radix-ui/react-tooltip": {
      "optional": false
    },
    "@radix-ui/react-popover": {
      "optional": false
    },
    "@radix-ui/react-dialog": {
      "optional": false
    },
    "@radix-ui/react-tabs": {
      "optional": false
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  }
}
