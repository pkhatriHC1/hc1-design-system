{
  "name": "@hc1/design-system",
  "version": "0.11.0",
  "description": "HC1 design system \u2014 Radix + Tailwind v4 + cva composition, HC1 tokens. Shared UI package for ClinicalIQ, SourceIQ, HerCare, and future modules.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs",
      "default": "./dist/tokens/index.js"
    },
    "./styles": "./dist/styles.css",
    "./playground": {
      "types": "./dist/playground.d.ts",
      "import": "./dist/playground.js",
      "require": "./dist/playground.cjs",
      "default": "./dist/playground.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    },
    "class-variance-authority": {
      "optional": false
    },
    "clsx": {
      "optional": false
    },
    "tailwind-merge": {
      "optional": false
    },
    "@radix-ui/react-slot": {
      "optional": false
    },
    "@radix-ui/react-tooltip": {
      "optional": false
    },
    "@radix-ui/react-popover": {
      "optional": false
    },
    "@radix-ui/react-dialog": {
      "optional": false
    },
    "@radix-ui/react-tabs": {
      "optional": false
    },
    "@radix-ui/react-select": {
      "optional": false
    },
    "@radix-ui/react-progress": {
      "optional": false
    },
    "@radix-ui/react-separator": {
      "optional": false
    },
    "@radix-ui/react-scroll-area": {
      "optional": false
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}